{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Tests run on Node's built-in runner via type stripping, which requires
    // explicit `.ts` specifiers. Safe with noEmit (set by expo/tsconfig.base).
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
